AGROFIELD_PROVIDER=local
AGROFIELD_DB_PATH=agrofield.sqlite3

# Required only when AGROFIELD_PROVIDER=nebius
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# Required safety gates for AGROFIELD_PROVIDER=nebius. Verify current prices first.
NEBIUS_INPUT_PRICE_PER_MILLION=
NEBIUS_OUTPUT_PRICE_PER_MILLION=
NEBIUS_MAX_COST_USD=
NEBIUS_MAX_COMPLETION_TOKENS=1024
NEBIUS_PROMPT_TOKEN_BUDGET=16384
NEBIUS_REASONING_EFFORT=low
AGROFIELD_NEBIUS_LIVE_CONFIRMATION=

# Optional. The app works without Tavily.
TAVILY_API_KEY=
TAVILY_INCLUDE_DOMAINS=inta.gob.ar,smn.gob.ar,senasa.gob.ar,crops.extension.iastate.edu,extension.umn.edu
