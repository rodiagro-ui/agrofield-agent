AGROFIELD_PROVIDER=local
AGROFIELD_DB_PATH=agrofield.sqlite3

# Required only when AGROFIELD_PROVIDER=nebius
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# Required safety gates for AGROFIELD_PROVIDER=nebius. Verify current prices first.
NEBIUS_INPUT_PRICE_PER_MILLION=
NEBIUS_OUTPUT_PRICE_PER_MILLION=
NEBIUS_MAX_COST_USD=
NEBIUS_MAX_COMPLETION_TOKENS=1024
NEBIUS_PROMPT_TOKEN_BUDGET=16384
NEBIUS_REASONING_EFFORT=none
AGROFIELD_NEBIUS_LIVE_CONFIRMATION=

# Public demo mode (AGROFIELD_PROVIDER=nebius-demo): many guarded single requests,
# each admitted by a persistent spend ledger. Requires the prices and cap above
# plus every line below; the app refuses to start otherwise. Never the default.
AGROFIELD_NEBIUS_DEMO_CONFIRMATION=
AGROFIELD_DEMO_TOTAL_BUDGET_USD=
AGROFIELD_DEMO_DAILY_REQUESTS=200
AGROFIELD_DEMO_REQUESTS_PER_MINUTE=6
AGROFIELD_DEMO_LEDGER_PATH=
# Optional second-pass support verifier for demo mode: another Nemotron call
# judges whether each quote supports its value; unsupported values become
# questions. Leave empty to disable. Prices are per million tokens.
AGROFIELD_VERIFIER_MODEL=
NEBIUS_VERIFIER_INPUT_PRICE_PER_MILLION=
NEBIUS_VERIFIER_OUTPUT_PRICE_PER_MILLION=

# Optional. The app works without Tavily.
TAVILY_API_KEY=
TAVILY_INCLUDE_DOMAINS=inta.gob.ar,smn.gob.ar,senasa.gob.ar,crops.extension.iastate.edu,extension.umn.edu
